{% extends 'base.html.twig' %}

{% block body %}
	<div class="container-fluid">
		<div class="row">
			<nav class="col-md-3 col-lg-2 d-none d-md-block bg-dark sidebar min-vh-100 p-4">
				<div class="position-sticky d-flex flex-column h-100">
					<div>
						<h1 class="text-white">Admin</h1>

						<ul class="nav flex-column">
							<li class="nav-item">
								<a class="nav-link" href="{{ path('admin_media_index') }}">
									Médias
								</a>
							</li>

							{% if is_granted('ROLE_ADMIN') %}
								<li class="nav-item">
									<a class="nav-link" href="{{ path('admin_album_index') }}">
										Albums
									</a>
								</li>
								<li class="nav-item">
									<a class="nav-link" href="{{ path('admin_guest_index') }}">
										Invités
									</a>
								</li>
								<div class="mt-auto pt-3 border-top">
									<a href="{{ path('admin_logout') }}" class="btn btn-outline-light w-100">
										Se déconnecter
									</a>
								</div>
							{% endif %}
						</ul>
					</div>
				</nav>

				<main class="col-md-9 ms-sm-auto col-lg-10 p-4">
					{% include '_flash_messages.html.twig' %}
					{% block admin %}{% endblock %}
				</main>
			</div>
		</div>
	{% endblock %}
